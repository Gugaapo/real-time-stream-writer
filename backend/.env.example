# DeepSeek vision key. Without it the page loads and does not call the model.
DEEPSEEK_API_KEY=

HOST=127.0.0.1
PORT=8005
CORS_ORIGINS=https://tossemideia.cloud

DATABASE_PATH=/data/livrinho.sqlite
CHANNEL=omeiaum
NOVEL_BASE_URL=https://api.deepseek.com
NOVEL_MODEL=deepseek-v4-flash-vision-exp
INTERVAL_SECONDS=15
CHANGE_THRESHOLD=1.5
GRACE_SECONDS=45
MAX_LIVE_SESSIONS=8
FRAME_WIDTH=640
FRAME_HEIGHT=360
FPS=2

# Stop model calls for the rest of the UTC month once estimated Flash spend hits this.
MONTHLY_CAP_USD=10
